{
  "_comment": [
    "Copy to settings.json to activate. See ARCHITECTURE.md for what each hook is for.",
    "PreToolUse can BLOCK a tool call (exit 2) - it is the only enforcement point.",
    "SessionStart output is injected into the conversation.",
    "Note the 'compact' matcher on SessionStart: that is how you re-inject context after",
    "compaction. PostCompact does NOT get its output back into the conversation."
  ],

  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/block-secret-commit.sh"
          }
        ]
      }
    ],

    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/session-start-check.sh"
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/session-start-check.sh"
          }
        ]
      }
    ],

    "_Stop_example": [
      {
        "_comment": [
          "Uncomment to refuse ending a turn while checks fail. This is the counterweight",
          "to permissive auto-accept modes: those judge whether an action is DANGEROUS, not",
          "whether the result is CORRECT. Broken code is not dangerous, so it sails through.",
          "A Stop hook running your suite is what actually catches it."
        ],
        "hooks": [
          {
            "type": "command",
            "command": "npm test --silent"
          }
        ]
      }
    ],

    "_PostToolUse_example": [
      {
        "_comment": "Uncomment to auto-format after every file write.",
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "npx prettier --write \"$CLAUDE_FILE_PATH\""
          }
        ]
      }
    ]
  }
}
