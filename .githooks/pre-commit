#!/usr/bin/env bash
# git pre-commit hook. Activate it once per clone:
#
#     git config core.hooksPath .githooks
#
# Project documents (solution docs, TDD, BRD, SOW, call recordings, client data) must never
# reach GitHub — once pushed they stay in history for good, even after deletion.
# .gitignore keeps them out of a normal `git add`, but `git add -f` bypasses .gitignore.
# This hook is the backstop: it inspects what is actually staged, and it runs for EVERY
# commit on this machine, including ones made in a terminal outside Claude.
#
# It refuses credentials files and HAR network captures for the same reason.

set -uo pipefail

root="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
cd "$root" || exit 0

if [ -f .githooks/kb-allowlist.sh ]; then
  # shellcheck source=/dev/null
  . .githooks/kb-allowlist.sh
else
  KB_ALLOWED_RE='^knowledge-base/(README\.md|sync-config\.json|[^/]+/INDEX\.md|[^/]+/\.gitkeep)$'
fi

staged="$(git -c core.quotepath=off diff --cached --name-only --diff-filter=ACMR)"
[ -z "$staged" ] && exit 0

bad_docs="$(printf '%s\n' "$staged" | grep '^knowledge-base/' | grep -Ev "$KB_ALLOWED_RE" || true)"
bad_secrets="$(printf '%s\n' "$staged" \
  | grep -E '(^|/)qa-test-env\.md$|\.har$|(^|/)\.env(\..+)?$' \
  | grep -v '\.env\.example$' || true)"

[ -z "$bad_docs" ] && [ -z "$bad_secrets" ] && exit 0

{
  echo ""
  echo "BLOCKED by .githooks/pre-commit — nothing was committed."
  if [ -n "$bad_docs" ]; then
    echo ""
    echo "Project documents must never be committed. They are synced locally from Google"
    echo "Drive (see knowledge-base/README.md); only the INDEX.md files are shared in git."
    printf '%s\n' "$bad_docs" | while IFS= read -r f; do [ -n "$f" ] && echo "   - $f"; done
  fi
  if [ -n "$bad_secrets" ]; then
    echo ""
    echo "Credentials files and HAR captures (which carry session cookies) must never be committed:"
    printf '%s\n' "$bad_secrets" | while IFS= read -r f; do [ -n "$f" ] && echo "   - $f"; done
  fi
  echo ""
  echo "Unstage them with:   git restore --staged <file>"
  echo ""
} >&2
exit 1
