{
  "_comment": [
    "Copy to .mcp.json to share MCP server config with everyone who clones this repo.",
    "Teammates see 'Pending approval' on first run and approve it themselves; each still",
    "authenticates remote servers with their own login. Nothing secret belongs in here.",
    "",
    "Local (stdio) servers start as a subprocess on the teammate's machine and have no",
    "Connectors-UI path - they must come from here or from `claude mcp add`.",
    "Remote (http) servers can alternatively be added through the Connectors UI."
  ],

  "mcpServers": {
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@playwright/mcp@latest"]
    },

    "_tracker_example": {
      "_comment": "Issue tracker. Replace with your provider's remote MCP endpoint.",
      "type": "http",
      "url": "https://<your-tracker-mcp-endpoint>"
    },

    "_backend_example": {
      "_comment": [
        "System of record - the database, ERP or admin API the skills query to verify",
        "what the UI displays. If this endpoint is internal, do NOT commit it: keep it",
        "out of the repo and have each teammate add it locally with `claude mcp add`."
      ],
      "type": "http",
      "url": "https://<your-backend-mcp-endpoint>"
    }
  }
}
